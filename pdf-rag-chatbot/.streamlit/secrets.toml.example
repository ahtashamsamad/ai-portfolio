# Streamlit secrets — EXAMPLE ONLY. Never commit real keys.
#
# To use:
#   1. Copy this file to `.streamlit/secrets.toml` (same folder as this file).
#   2. Fill in your real key. The real secrets.toml is git-ignored.
#   3. On Streamlit Community Cloud, paste the same TOML into
#      App settings -> Secrets instead.
#
# The app also accepts the key in the sidebar as a fallback; a key in
# st.secrets always takes precedence.

# OPENAI_API_KEY = "sk-your-key-here"
